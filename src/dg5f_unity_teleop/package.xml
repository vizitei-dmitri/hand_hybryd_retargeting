<?xml version="1.0"?>
<package format="3">
  <name>dg5f_unity_teleop</name>
  <version>0.1.0</version>
  <description>Unity Quest Mano landmarks adapter and DG5F V2 launch.</description>
  <maintainer email="maintainer@example.com">hand workspace maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>rclpy</depend>
  <depend>vr_haptic_msgs</depend>
  <exec_depend>dg5f_teleop</exec_depend>
  <exec_depend>lerobot_robot_dg5f</exec_depend>
  <exec_depend>ros_tcp_endpoint</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
